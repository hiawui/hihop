{
  "name": "hihop",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.tools.json",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/vectors/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "build": "tsc && vite build",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "start": "node dist/server.js",
    "install:launcher": "node scripts/hihop.mjs install"
  },
  "dependencies": {
    "dns-packet": "^5.6.1",
    "fastify": "^5.6.2",
    "ipaddr.js": "^2.2.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/dns-packet": "^5.6.5",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
